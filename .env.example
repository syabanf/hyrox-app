# Copy to .env and adjust. Every setting has a development default, so an
# empty file still runs against the compose database.

# ── Runtime ───────────────────────────────────────────────────────────────────
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
# The studio's timezone. Reports, payroll periods and "today" resolve against
# it rather than against UTC.
STUDIO_TIMEZONE=Asia/Jakarta

# Origins allowed to call the API from a browser. Narrow this in production to
# the member PWA and admin panel.
HTTP_ALLOWED_ORIGINS=*

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://nuhabit:nuhabit@localhost:5433/nuhabit?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2

# Set to false to apply migrations out of band instead of at boot.
AUTO_MIGRATE=true

# ── Authentication ────────────────────────────────────────────────────────────
# Signs the bearer tokens. Every service that verifies them needs the same
# value; the process refuses to start in production with the default.
AUTH_SECRET=dev-secret-change-me
AUTH_TOKEN_TTL=720h
AUTH_OTP_TTL=5m
AUTH_OTP_LENGTH=6

# Demo mode returns the sign-in code in the response, accepts any well-formed
# code, and lets staff sign in by picking a role. It must be false in
# production, and the process refuses to start otherwise.
AUTH_DEMO_OTP=true

# ── Payments ──────────────────────────────────────────────────────────────────
# "mock" issues fake invoices and settles through the simulate endpoint.
# "xendit" talks to the real gateway and requires the keys below.
PAYMENTS_PROVIDER=mock
PAYMENTS_INVOICE_TTL=24h
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=

# ── Modules ───────────────────────────────────────────────────────────────────
# Which bounded contexts this process mounts. "all" is the modular monolith;
# a comma-separated subset turns the same binary into one service.
#   MODULES=catalog,identity,scheduling,access,reporting
#   MODULES=wallet,incentives
MODULES=all

# ── Tests ─────────────────────────────────────────────────────────────────────
# Integration tests are skipped unless this points at a throwaway database.
TEST_DATABASE_URL=postgres://nuhabit:nuhabit@localhost:5433/nuhabit_test?sslmode=disable
