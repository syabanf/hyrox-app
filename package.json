{
  "name": "nuhabit",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:member": "pnpm --filter @nuhabit/member dev",
    "dev:admin": "pnpm --filter @nuhabit/admin dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:backend": "pnpm --filter @nuhabit/backend dev",
    "stack:up": "docker compose up -d --build && docker compose --profile seed run --rm seed",
    "stack:down": "docker compose down",
    "stack:reset": "docker compose down -v",
    "stack:logs": "docker compose logs -f api"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.4.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0"
  }
}
